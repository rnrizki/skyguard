<div class="page-container">
  <!-- Controls Toolbar -->
  <div class="toolbar">
    <div class="toolbar-left">
      <h2 class="section-title">
        <span class="indicator-dot"></span>
        Live Monitoring Hub
      </h2>
    </div>

    <div class="toolbar-right">
      <div class="stream-quality-pills" id="quality-selector">
        <button type="button" class="btn btn-sm quality-btn active" id="btn-quality-smooth" title="Mode Lancar 25 FPS (Sub-Stream ringan, hemat kuota & anti-lag)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          ⚡ Lancar (25 FPS)
        </button>
        <button type="button" class="btn btn-sm quality-btn" id="btn-quality-hd" title="Mode HD (Main-Stream resolusi penuh)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect><polyline points="17 2 12 7 7 2"></polyline></svg>
          💎 HD
        </button>
      </div>
      <button id="btn-reconnect-all" class="btn btn-secondary btn-sm" title="Refresh all streams">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="23 4 23 10 17 10"></polyline>
          <polyline points="1 20 1 14 7 14"></polyline>
          <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
        </svg>
        Reconnect All
      </button>
    </div>
  </div>

  <!-- Multi-Select Camera Radio/Pill Bar -->
  <div class="camera-pills-bar">
    <div class="camera-pill-selector" id="live-camera-selector">
      <button type="button" class="cam-radio-pill active" data-cam="all">
        <span class="pill-dot"></span>
        <span>Semua Kamera</span>
      </button>
      {{#each cameras}}
      <button type="button" class="cam-radio-pill" data-cam="{{this.id}}">
        <span class="pill-dot"></span>
        <span>{{this.name}}</span>
      </button>
      {{/each}}
    </div>
  </div>

  <!-- Camera Video Grid (Enforced 16:9 Ratio) -->
  <div id="camera-grid" class="camera-grid grid-3x3">
    {{#each cameras}}
    <div class="camera-card" id="card-{{this.id}}" data-stream="{{this.stream}}" data-stream-sub="{{this.streamSub}}" data-cam-id="{{this.id}}">
      <!-- Camera Card Header Badge -->
      <div class="camera-header">
        <div class="camera-title-badge">
          <span class="status-indicator online"></span>
          <span class="camera-name">{{this.name}}</span>
          <span class="camera-loc">{{this.location}}</span>
        </div>
        <div class="camera-controls">
          <button class="cam-btn btn-fullscreen" title="Fullscreen" onclick="toggleCamFullscreen('card-{{this.id}}')">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- 16:9 Aspect Ratio Video Viewport (Tap / Click to Fullscreen) -->
      <div class="video-viewport" onclick="toggleCamFullscreen('card-{{this.id}}')">
        <!-- Live Loading Spinner -->
        <div class="video-loader" id="loader-{{this.id}}">
          <div class="spinner"></div>
          <span>Connecting WebRTC Stream...</span>
        </div>

        <!-- Video Element (object-fit: fill forces 16:9 anamorphic stretch) -->
        <video 
          id="video-{{this.id}}" 
          autoplay 
          muted 
          playsinline 
          class="surveillance-video"
        ></video>
      </div>

      <!-- Footer Overlay -->
      <div class="camera-footer">
        <span class="stream-tech-badge">WebRTC &bull; Main Stream</span>
        <span class="timestamp-display" id="time-{{this.id}}">--:--:--</span>
      </div>
    </div>
    {{/each}}
  </div>
</div>

<script src="/js/webrtc.js"></script>
<script src="/js/app.js"></script>
