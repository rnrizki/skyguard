<div class="page-container">
  <!-- Page Header -->
  <div class="toolbar">
    <div class="toolbar-left">
      <h2 class="section-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        Surveillance Recordings & Events
      </h2>
    </div>
  </div>

  <!-- Multi-Select Camera Radio/Pill Bar (Exact same layout as Live tab) -->
  <div class="camera-pills-bar">
    <div class="camera-pill-selector" id="recordings-camera-selector">
      <button type="button" class="cam-radio-pill active" data-cam="all">
        <span class="pill-dot"></span>
        <span>Semua Kamera</span>
      </button>
      {{#each cameras}}
      <button type="button" class="cam-radio-pill" data-cam="{{this.id}}">
        <span class="pill-dot"></span>
        <span>{{this.name}}</span>
      </button>
      {{/each}}
    </div>
  </div>

  <!-- Search & Filter Card -->
  <div class="filter-card">
    <form id="recordings-filter-form" class="filter-form">
      <input type="hidden" id="filter-camera" name="camera" value="all">

      <!-- Object Label Filter (Active in Events Mode) -->
      <div class="form-field" id="field-filter-label">
        <label for="filter-label">Object Type</label>
        <select id="filter-label" name="label" class="form-select">
          <option value="all">All Objects (Person, Car, etc.)</option>
          <option value="person">🚶 Person (Orang)</option>
          <option value="car">🚗 Car (Mobil)</option>
          <option value="motorcycle">🏍️ Motorcycle (Motor)</option>
          <option value="dog">🐕 Dog (Anjing)</option>
          <option value="cat">🐈 Cat (Kucing)</option>
        </select>
      </div>

      <!-- Date Filter: ALWAYS VISIBLE PER USER REQUEST -->
      <div class="form-field" id="field-filter-date">
        <label for="filter-date">Date / Tanggal (WIB)</label>
        <select id="filter-date" name="date" class="form-select">
          <option value="">Semua Tanggal (Terbaru)</option>
        </select>
      </div>

      <!-- Hour Filter (Active in Archive Mode) -->
      <div class="form-field" id="field-filter-hour" style="display: none;">
        <label for="filter-hour">Hour (WIB)</label>
        <select id="filter-hour" name="hour" class="form-select">
          <option value="">All Hours (24H)</option>
          <option value="00">00:00 - 01:00</option>
          <option value="01">01:00 - 02:00</option>
          <option value="02">02:00 - 03:00</option>
          <option value="03">03:00 - 04:00</option>
          <option value="04">04:00 - 05:00</option>
          <option value="05">05:00 - 06:00</option>
          <option value="06">06:00 - 07:00</option>
          <option value="07">07:00 - 08:00</option>
          <option value="08">08:00 - 09:00</option>
          <option value="09">09:00 - 10:00</option>
          <option value="10">10:00 - 11:00</option>
          <option value="11">11:00 - 12:00</option>
          <option value="12">12:00 - 13:00</option>
          <option value="13">13:00 - 14:00</option>
          <option value="14">14:00 - 15:00</option>
          <option value="15">15:00 - 16:00</option>
          <option value="16">16:00 - 17:00</option>
          <option value="17">17:00 - 18:00</option>
          <option value="18">18:00 - 19:00</option>
          <option value="19">19:00 - 20:00</option>
          <option value="20">20:00 - 21:00</option>
          <option value="21">21:00 - 22:00</option>
          <option value="22">22:00 - 23:00</option>
          <option value="23">23:00 - 24:00</option>
        </select>
      </div>

      <!-- Action Button -->
      <div class="form-field form-field-btn">
        <button type="submit" class="btn btn-primary btn-block" id="btn-filter-submit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span id="btn-submit-text">Cari Kejadian</span>
        </button>
      </div>
    </form>
  </div>

  <!-- Results Section -->
  <div class="results-container">
    <div class="results-header">
      <div class="results-title-group">
        <h3 id="results-title">Tracked Object Events</h3>
        <span id="results-count" class="badge badge-secondary">Memuat kejadian...</span>
      </div>

      <!-- Archive View Mode Selector (shown only in Archive mode) -->
      <div class="view-mode-toggle" id="archive-view-mode-toggle" style="display: none;">
        <button type="button" class="view-btn active" data-mode="sessions" id="btn-mode-sessions" title="Tampilkan kejadian & sesi rekaman utuh">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          Video Utuh (Sesi)
        </button>
        <button type="button" class="view-btn" data-mode="segments" id="btn-mode-segments" title="Tampilkan semua pecahan segmen 10 detik">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
          </svg>
          Segmen 10 Detik
        </button>
      </div>
    </div>

    <!-- Empty State -->
    <div id="results-empty" class="empty-state">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <p id="results-empty-msg">Tidak ada rekaman atau kejadian (> 3 detik) yang ditemukan untuk filter yang dipilih.</p>
    </div>

    <!-- Loading State -->
    <div id="results-loading" class="loading-state" style="display: none;">
      <div class="spinner"></div>
      <p id="results-loading-msg">Memuat data video kejadian dari ParadeDB...</p>
    </div>

    <!-- Video Grid -->
    <div id="clips-grid" class="clips-grid" style="display: none;"></div>

    <!-- Modern Events Pagination Controls -->
    <div id="events-pagination-container" class="events-pagination-bar" style="display: none;">
      <div class="pagination-info">
        <span id="pagination-info-text">Menampilkan halaman 1</span>
      </div>
      <div class="pagination-buttons">
        <button type="button" id="btn-page-first" class="pag-btn" title="Halaman Pertama">⏮ Pertama</button>
        <button type="button" id="btn-page-prev" class="pag-btn" title="Halaman Sebelumnya">◀ Sebelumnya</button>
        <div id="pagination-numbers" class="pag-numbers"></div>
        <button type="button" id="btn-page-next" class="pag-btn" title="Halaman Selanjutnya">Selanjutnya ▶</button>
        <button type="button" id="btn-page-last" class="pag-btn" title="Halaman Terakhir">Terakhir ⏭</button>
      </div>
      <div class="pagination-jump">
        <span>Ke Hal:</span>
        <input type="number" id="input-page-jump" min="1" max="1" value="1" class="pag-jump-input">
        <button type="button" id="btn-page-jump" class="pag-jump-btn">Buka</button>
      </div>
    </div>
  </div>
</div>

<!-- ========================================================== -->
<!-- FRIGATE TRACKED OBJECT DETAILS MODAL (WITH GEMINI AI TAB)  -->
<!-- ========================================================== -->
<div id="tracked-object-modal" class="modal" style="display: none;">
  <div class="modal-overlay" onclick="closeTrackedModal()"></div>
  <div class="modal-dialog tracked-modal-dialog">
    <!-- Modal Header -->
    <div class="modal-header">
      <h3 class="modal-title">Tracked Object Details</h3>
      <button class="modal-close-btn" onclick="closeTrackedModal()">&times;</button>
    </div>

    <!-- 2-Column Body: Left Video, Right Details Timeline & AI -->
    <div class="tracked-modal-body">
      <!-- Left Column: Unified Video Player & Controls -->
      <div class="tracked-video-col">
        <div class="tracked-video-wrapper">
          <video id="tracked-video-player" controls autoplay playsinline class="modal-video"></video>
          <div id="tracked-video-loading" class="tracked-video-loading" style="display:none;">
            <span id="tracked-loading-msg">Memuat rekaman dari AWS S3 RustFS...</span>
          </div>
        </div>

        <div class="tracked-video-controls">
          <div class="playback-controls">
            <label>Speed:</label>
            <button class="speed-btn active" onclick="setTrackedSpeed(1)">1.0x</button>
            <button class="speed-btn" onclick="setTrackedSpeed(1.5)">1.5x</button>
            <button class="speed-btn" onclick="setTrackedSpeed(2)">2.0x</button>
          </div>

          <!-- S3 Segment Navigation Controls (Like AWS Archive Playback) -->
          <div class="session-nav-controls" id="tracked-session-nav" style="display:none;">
            <button type="button" class="btn btn-secondary btn-sm" id="btn-tracked-prev" onclick="playTrackedPrevSegment()" title="Segmen S3 Sebelumnya">
              ⏮ Sebelumnya
            </button>
            <button type="button" class="btn btn-secondary btn-sm" id="btn-tracked-next" onclick="playTrackedNextSegment()" title="Segmen S3 Selanjutnya">
              Selanjutnya ⏭
            </button>
            <span id="tracked-segment-counter" class="badge badge-info" style="font-size:0.75rem;">Segmen 1 / 1</span>
          </div>

          <div style="display:flex;gap:6px;align-items:center;">
            <a id="tracked-download-btn" href="#" download class="btn btn-secondary btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Download MP4
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Tabs (Thumbnail / Tracking Details / Gemini AI) -->
      <div class="tracked-details-col">
        <!-- Top Tab Pills -->
        <div class="tracked-tabs-nav">
          <button type="button" class="tracked-nav-pill" id="tab-pill-thumb" onclick="switchTrackedTab('thumbnail')">Thumbnail</button>
          <button type="button" class="tracked-nav-pill active" id="tab-pill-details" onclick="switchTrackedTab('details')">Tracking Details</button>
        </div>

        <!-- Tracking Details Pane -->
        <div id="tracked-pane-details" class="tracked-pane">
          <div class="event-meta-header">
            <div class="event-meta-title">
              <span id="dtl-obj-icon" class="event-icon">🚶</span>
              <span id="dtl-obj-label" class="event-label-text">Person</span>
            </div>
            <div id="dtl-obj-timerange" class="event-timerange-text">
              Oct 24, 10:01:10 PM - Oct 24, 10:04:45 PM
            </div>
          </div>

          <!-- Vertical Tracking Timeline -->
          <div class="tracking-timeline-wrapper">
            <div class="timeline-line"></div>
            <div id="timeline-items" class="timeline-items"></div>
          </div>
        </div>

        <!-- Thumbnail Pane -->
        <div id="tracked-pane-thumbnail" class="tracked-pane" style="display: none;">
          <div class="tracked-thumbnail-wrapper">
            <img id="dtl-thumb-img" src="" alt="Tracked Object Snapshot" class="tracked-thumb-img">
          </div>
        </div>

        <!-- Gemini AI Analysis Pane -->
        <div id="tracked-pane-ai" class="tracked-pane" style="display: none;">
          <div class="ai-analysis-container">
            <div class="ai-header-bar">
              <div class="ai-title-group">
                <span class="ai-badge-label">🤖 Gemini 3.8 Flash Vision</span>
                <span id="ai-risk-level-badge" class="badge badge-warning">Menganalisis...</span>
              </div>
              <button type="button" class="btn btn-ghost btn-xs" onclick="runAiAnalysis(true)" title="Analisis ulang">
                🔄 Refresh
              </button>
            </div>

            <div id="ai-loading" class="ai-loading-box" style="display: none;">
              <div class="spinner"></div>
              <p>Gemini sedang menganalisis rekaman gambar & konteks visual...</p>
            </div>

            <div id="ai-results-box" class="ai-results-box">
              <div class="ai-section">
                <label class="ai-section-label">📋 Ringkasan Kejadian:</label>
                <p id="ai-summary-text" class="ai-section-text">Klik "Analisis AI" untuk memulai.</p>
              </div>

              <div class="ai-section">
                <label class="ai-section-label">🔍 Aktivitas Teramati:</label>
                <p id="ai-activity-text" class="ai-section-text">--</p>
              </div>

              <div class="ai-section">
                <label class="ai-section-label">🛡️ Rekomendasi Keamanan:</label>
                <p id="ai-recommendation-text" class="ai-section-text">--</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ========================================================== -->
<!-- GEMINI AI DAILY BRIEFING MODAL                             -->
<!-- ========================================================== -->
<div id="daily-briefing-modal" class="modal" style="display: none;">
  <div class="modal-overlay" onclick="closeDailyBriefingModal()"></div>
  <div class="modal-dialog ai-briefing-dialog">
    <div class="modal-header">
      <div class="modal-title-group">
        <h3 class="modal-title">✨ Laporan Intelijen Keamanan AI (Gemini)</h3>
        <p id="briefing-subtitle">Rangkuman situasi keamanan harian otomatis</p>
      </div>
      <button class="modal-close-btn" onclick="closeDailyBriefingModal()">&times;</button>
    </div>

    <div class="modal-body briefing-modal-body">
      <div id="briefing-loading" class="loading-state" style="display: none;">
        <div class="spinner"></div>
        <p>Gemini AI sedang menganalisis seluruh data rekaman & kejadian hari ini...</p>
      </div>

      <div id="briefing-content" class="briefing-content">
        <!-- Dynamically populated by JS -->
      </div>
    </div>

    <div class="modal-footer">
      <button type="button" class="btn btn-secondary btn-sm" onclick="closeDailyBriefingModal()">Tutup</button>
      <button type="button" class="btn btn-primary btn-sm" onclick="loadDailyBriefing(true)">🔄 Muat Ulang Briefing</button>
    </div>
  </div>
</div>

<!-- ========================================================== -->
<!-- 24/7 ARCHIVE PLAYBACK MODAL (Continuous Session Fallback)   -->
<!-- ========================================================== -->
<div id="video-modal" class="modal" style="display: none;">
  <div class="modal-overlay" onclick="closeVideoModal()"></div>
  <div class="modal-dialog">
    <div class="modal-header">
      <div class="modal-title-group">
        <div style="display:flex;align-items:center;gap:8px;">
          <h3 id="modal-video-title">Playback Recording</h3>
          <span id="modal-segment-counter" class="badge badge-info" style="display:none;">Segmen 1 dari 1</span>
        </div>
        <p id="modal-video-subtitle">--</p>
      </div>
      <button class="modal-close-btn" onclick="closeVideoModal()">&times;</button>
    </div>

    <div class="modal-body">
      <div class="modal-video-wrapper">
        <video id="modal-video-player" controls autoplay playsinline class="modal-video"></video>
      </div>
    </div>

    <div class="modal-footer">
      <div class="playback-controls">
        <label>Speed:</label>
        <button class="speed-btn active" onclick="setSpeed(1)">1.0x</button>
        <button class="speed-btn" onclick="setSpeed(1.5)">1.5x</button>
        <button class="speed-btn" onclick="setSpeed(2)">2.0x</button>
        <button class="speed-btn" onclick="setSpeed(4)">4.0x</button>
      </div>

      <div class="session-nav-controls" id="modal-session-nav" style="display: none;">
        <button type="button" class="btn btn-secondary btn-sm" id="btn-prev-segment" onclick="playPrevSegment()" title="Segmen Sebelumnya">
          ⏮ Sebelumnya
        </button>
        <button type="button" class="btn btn-secondary btn-sm" id="btn-next-segment" onclick="playNextSegment()" title="Segmen Selanjutnya">
          Selanjutnya ⏭
        </button>
        <label class="auto-next-label" title="Putar segmen berikutnya otomatis tanpa jeda">
          <input type="checkbox" id="chk-auto-next" checked>
          <span>Lanjut Otomatis (Tanpa Putus)</span>
        </label>
      </div>

      <a id="modal-download-btn" href="#" download class="btn btn-secondary btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download MP4
      </a>
    </div>
  </div>
</div>

<script src="/js/recordings.js"></script>
