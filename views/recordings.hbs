<div class="page-container">
  <!-- Page Header -->
  <div class="toolbar">
    <div class="toolbar-left">
      <h2 class="section-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        S3 Cloud Recordings Archive
      </h2>
      <span class="badge badge-success" id="sync-badge">ParadeDB High-Speed Index</span>
    </div>

    <div class="toolbar-right">
      <div class="s3-info-pill">
        <span>Bucket: <strong>frigate/recordings</strong></span>
      </div>
    </div>
  </div>

  <!-- Search & Filter Card -->
  <div class="filter-card">
    <form id="recordings-filter-form" class="filter-form">
      <!-- Camera Filter (Frigate Popover Style with Radio Switches) -->
      <div class="form-field camera-popover-field">
        <label>Camera</label>
        <input type="hidden" id="filter-camera" name="camera" value="all">
        <div class="camera-filter-wrapper">
          <button type="button" id="camera-dropdown-btn" class="camera-dropdown-btn">
            <div class="btn-cam-label">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
              </svg>
              <span id="selected-camera-text">All Cameras</span>
            </div>
            <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <!-- Frigate-Style Dropdown Popover -->
          <div id="camera-popover" class="frigate-popover" style="display: none;">
            <div class="popover-section-title">Semua_kamera</div>
            <div class="camera-radio-list">
              <div class="camera-radio-item active" data-cam="all" data-name="All Cameras">
                <span class="cam-item-label">All Cameras</span>
                <span class="toggle-pill active"><span class="toggle-circle"></span></span>
              </div>
              {{#each cameras}}
              <div class="camera-radio-item" data-cam="{{this.id}}" data-name="{{this.name}}">
                <span class="cam-item-label">{{this.name}}</span>
                <span class="toggle-pill"><span class="toggle-circle"></span></span>
              </div>
              {{/each}}
            </div>
            <div class="popover-actions">
              <button type="button" id="btn-camera-apply" class="btn btn-primary btn-sm">Apply</button>
              <button type="button" id="btn-camera-reset" class="btn btn-ghost btn-sm">Reset</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Date Filter -->
      <div class="form-field">
        <label for="filter-date">Date (YYYY-MM-DD)</label>
        <select id="filter-date" name="date" class="form-select">
          <option value="">Loading dates...</option>
        </select>
      </div>

      <!-- Hour Filter -->
      <div class="form-field">
        <label for="filter-hour">Hour (WIB)</label>
        <select id="filter-hour" name="hour" class="form-select">
          <option value="">All Hours (24H)</option>
          <option value="00">00:00 - 01:00</option>
          <option value="01">01:00 - 02:00</option>
          <option value="02">02:00 - 03:00</option>
          <option value="03">03:00 - 04:00</option>
          <option value="04">04:00 - 05:00</option>
          <option value="05">05:00 - 06:00</option>
          <option value="06">06:00 - 07:00</option>
          <option value="07">07:00 - 08:00</option>
          <option value="08">08:00 - 09:00</option>
          <option value="09">09:00 - 10:00</option>
          <option value="10">10:00 - 11:00</option>
          <option value="11">11:00 - 12:00</option>
          <option value="12">12:00 - 13:00</option>
          <option value="13">13:00 - 14:00</option>
          <option value="14">14:00 - 15:00</option>
          <option value="15">15:00 - 16:00</option>
          <option value="16">16:00 - 17:00</option>
          <option value="17">17:00 - 18:00</option>
          <option value="18">18:00 - 19:00</option>
          <option value="19">19:00 - 20:00</option>
          <option value="20">20:00 - 21:00</option>
          <option value="21">21:00 - 22:00</option>
          <option value="22">22:00 - 23:00</option>
          <option value="23">23:00 - 24:00</option>
        </select>
      </div>

      <!-- Action Button -->
      <div class="form-field form-field-btn">
        <button type="submit" class="btn btn-primary btn-block">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          Search Clips
        </button>
      </div>
    </form>
  </div>

  <!-- Results Section -->
  <div class="results-container">
    <div class="results-header">
      <div class="results-title-group">
        <h3 id="results-title">Recorded Video Clips</h3>
        <span id="results-count" class="badge badge-secondary">0 files found</span>
      </div>

      <!-- View Mode Selector (Video Utuh / Sesi vs Segmen 10s) -->
      <div class="view-mode-toggle">
        <button type="button" class="view-btn active" data-mode="sessions" id="btn-mode-sessions" title="Tampilkan kejadian & sesi rekaman utuh">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          Video Utuh (Kejadian & Sesi)
        </button>
        <button type="button" class="view-btn" data-mode="segments" id="btn-mode-segments" title="Tampilkan semua pecahan segmen 10 detik">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
            <line x1="3" y1="6" x2="3.01" y2="6"></line>
            <line x1="3" y1="12" x2="3.01" y2="12"></line>
            <line x1="3" y1="18" x2="3.01" y2="18"></line>
          </svg>
          Segmen 10 Detik
        </button>
      </div>
    </div>

    <!-- Empty State -->
    <div id="results-empty" class="empty-state">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <p>Select a date and click <strong>Search S3</strong> to view recorded video clips.</p>
    </div>

    <!-- Loading State -->
    <div id="results-loading" class="loading-state" style="display: none;">
      <div class="spinner"></div>
      <p>Fetching recordings index from S3 storage...</p>
    </div>

    <!-- Video Clips Grid -->
    <div id="clips-grid" class="clips-grid" style="display: none;"></div>
  </div>
</div>

<!-- Video Player Modal (Strict 16:9) -->
<div id="video-modal" class="modal" style="display: none;">
  <div class="modal-overlay" onclick="closeVideoModal()"></div>
  <div class="modal-dialog">
    <div class="modal-header">
      <div class="modal-title-group">
        <div style="display:flex;align-items:center;gap:8px;">
          <h3 id="modal-video-title">Playback Recording</h3>
          <span id="modal-segment-counter" class="badge badge-info" style="display:none;">Segmen 1 dari 1</span>
        </div>
        <p id="modal-video-subtitle">--</p>
      </div>
      <button class="modal-close-btn" onclick="closeVideoModal()">&times;</button>
    </div>

    <div class="modal-body">
      <!-- 16:9 Video Player -->
      <div class="modal-video-wrapper">
        <video id="modal-video-player" controls autoplay playsinline class="modal-video"></video>
      </div>
    </div>

    <div class="modal-footer">
      <div class="playback-controls">
        <label>Speed:</label>
        <button class="speed-btn active" onclick="setSpeed(1)">1.0x</button>
        <button class="speed-btn" onclick="setSpeed(1.5)">1.5x</button>
        <button class="speed-btn" onclick="setSpeed(2)">2.0x</button>
        <button class="speed-btn" onclick="setSpeed(4)">4.0x</button>
      </div>

      <!-- Continuous Session Playback Navigation -->
      <div class="session-nav-controls" id="modal-session-nav" style="display: none;">
        <button type="button" class="btn btn-secondary btn-sm" id="btn-prev-segment" onclick="playPrevSegment()" title="Segmen Sebelumnya">
          ⏮ Sebelumnya
        </button>
        <button type="button" class="btn btn-secondary btn-sm" id="btn-next-segment" onclick="playNextSegment()" title="Segmen Selanjutnya">
          Selanjutnya ⏭
        </button>
        <label class="auto-next-label" title="Putar segmen berikutnya otomatis tanpa jeda">
          <input type="checkbox" id="chk-auto-next" checked>
          <span>Lanjut Otomatis (Tanpa Putus)</span>
        </label>
      </div>

      <a id="modal-download-btn" href="#" download class="btn btn-secondary btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download MP4
      </a>
    </div>
  </div>
</div>

<script src="/js/recordings.js"></script>
