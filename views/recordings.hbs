<div class="page-container">
  <!-- Page Header -->
  <div class="toolbar">
    <div class="toolbar-left">
      <h2 class="section-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        Surveillance Recordings & Events
      </h2>
      <span class="badge badge-success" id="sync-badge">Frigate Event Engine (Active)</span>
    </div>

    <!-- Mode Selector: Tracked Events (Default) vs 24/7 Full Archive -->
    <div class="toolbar-right">
      <div class="mode-switch-group">
        <button type="button" class="mode-tab-btn active" id="tab-mode-events" onclick="setPrimaryMode('events')">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
          🎯 Kejadian / Tracked Objects (Utuh)
        </button>
        <button type="button" class="mode-tab-btn" id="tab-mode-archive" onclick="setPrimaryMode('archive')">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          📁 Arsip 24/7 (ParadeDB / S3)
        </button>
      </div>
    </div>
  </div>

  <!-- Search & Filter Card -->
  <div class="filter-card">
    <form id="recordings-filter-form" class="filter-form">
      <!-- Camera Filter (Frigate Popover Style with Radio Switches) -->
      <div class="form-field camera-popover-field">
        <label>Camera</label>
        <input type="hidden" id="filter-camera" name="camera" value="all">
        <div class="camera-filter-wrapper">
          <button type="button" id="camera-dropdown-btn" class="camera-dropdown-btn">
            <div class="btn-cam-label">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
              </svg>
              <span id="selected-camera-text">All Cameras</span>
            </div>
            <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <!-- Frigate-Style Dropdown Popover -->
          <div id="camera-popover" class="frigate-popover" style="display: none;">
            <div class="popover-section-title">Semua_kamera</div>
            <div class="camera-radio-list">
              <div class="camera-radio-item active" data-cam="all" data-name="All Cameras">
                <span class="cam-item-label">All Cameras</span>
                <span class="toggle-pill active"><span class="toggle-circle"></span></span>
              </div>
              {{#each cameras}}
              <div class="camera-radio-item" data-cam="{{this.id}}" data-name="{{this.name}}">
                <span class="cam-item-label">{{this.name}}</span>
                <span class="toggle-pill"><span class="toggle-circle"></span></span>
              </div>
              {{/each}}
            </div>
            <div class="popover-actions">
              <button type="button" id="btn-camera-apply" class="btn btn-primary btn-sm">Apply</button>
              <button type="button" id="btn-camera-reset" class="btn btn-ghost btn-sm">Reset</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Object Label Filter (Active in Events Mode) -->
      <div class="form-field" id="field-filter-label">
        <label for="filter-label">Object Type</label>
        <select id="filter-label" name="label" class="form-select">
          <option value="all">All Objects (Person, Car, etc.)</option>
          <option value="person">🚶 Person (Orang)</option>
          <option value="car">🚗 Car (Mobil)</option>
          <option value="motorcycle">🏍️ Motorcycle (Motor)</option>
          <option value="dog">🐕 Dog (Anjing)</option>
          <option value="cat">🐈 Cat (Kucing)</option>
        </select>
      </div>

      <!-- Date Filter (Active in Archive Mode or Date Navigation) -->
      <div class="form-field" id="field-filter-date" style="display: none;">
        <label for="filter-date">Date (YYYY-MM-DD)</label>
        <select id="filter-date" name="date" class="form-select">
          <option value="">Loading dates...</option>
        </select>
      </div>

      <!-- Hour Filter (Active in Archive Mode) -->
      <div class="form-field" id="field-filter-hour" style="display: none;">
        <label for="filter-hour">Hour (WIB)</label>
        <select id="filter-hour" name="hour" class="form-select">
          <option value="">All Hours (24H)</option>
          <option value="00">00:00 - 01:00</option>
          <option value="01">01:00 - 02:00</option>
          <option value="02">02:00 - 03:00</option>
          <option value="03">03:00 - 04:00</option>
          <option value="04">04:00 - 05:00</option>
          <option value="05">05:00 - 06:00</option>
          <option value="06">06:00 - 07:00</option>
          <option value="07">07:00 - 08:00</option>
          <option value="08">08:00 - 09:00</option>
          <option value="09">09:00 - 10:00</option>
          <option value="10">10:00 - 11:00</option>
          <option value="11">11:00 - 12:00</option>
          <option value="12">12:00 - 13:00</option>
          <option value="13">13:00 - 14:00</option>
          <option value="14">14:00 - 15:00</option>
          <option value="15">15:00 - 16:00</option>
          <option value="16">16:00 - 17:00</option>
          <option value="17">17:00 - 18:00</option>
          <option value="18">18:00 - 19:00</option>
          <option value="19">19:00 - 20:00</option>
          <option value="20">20:00 - 21:00</option>
          <option value="21">21:00 - 22:00</option>
          <option value="22">22:00 - 23:00</option>
          <option value="23">23:00 - 24:00</option>
        </select>
      </div>

      <!-- Action Button -->
      <div class="form-field form-field-btn">
        <button type="submit" class="btn btn-primary btn-block" id="btn-filter-submit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span id="btn-submit-text">Cari Kejadian</span>
        </button>
      </div>
    </form>
  </div>

  <!-- Results Section -->
  <div class="results-container">
    <div class="results-header">
      <div class="results-title-group">
        <h3 id="results-title">Tracked Object Events</h3>
        <span id="results-count" class="badge badge-secondary">Memuat kejadian...</span>
      </div>

      <!-- Archive View Mode Selector (shown only in Archive mode) -->
      <div class="view-mode-toggle" id="archive-view-mode-toggle" style="display: none;">
        <button type="button" class="view-btn active" data-mode="sessions" id="btn-mode-sessions" title="Tampilkan kejadian & sesi rekaman utuh">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          Video Utuh (Sesi)
        </button>
        <button type="button" class="view-btn" data-mode="segments" id="btn-mode-segments" title="Tampilkan semua pecahan segmen 10 detik">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
          </svg>
          Segmen 10 Detik
        </button>
      </div>
    </div>

    <!-- Empty State -->
    <div id="results-empty" class="empty-state">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <p id="results-empty-msg">Tidak ada rekaman atau kejadian yang ditemukan untuk filter yang dipilih.</p>
    </div>

    <!-- Loading State -->
    <div id="results-loading" class="loading-state" style="display: none;">
      <div class="spinner"></div>
      <p id="results-loading-msg">Memuat data video kejadian dari Frigate NVR...</p>
    </div>

    <!-- Video Grid -->
    <div id="clips-grid" class="clips-grid" style="display: none;"></div>
  </div>
</div>

<!-- ========================================================== -->
<!-- FRIGATE TRACKED OBJECT DETAILS MODAL (Exact Matching UI)   -->
<!-- ========================================================== -->
<div id="tracked-object-modal" class="modal" style="display: none;">
  <div class="modal-overlay" onclick="closeTrackedModal()"></div>
  <div class="modal-dialog tracked-modal-dialog">
    <!-- Modal Header -->
    <div class="modal-header">
      <h3 class="modal-title">Tracked Object Details</h3>
      <button class="modal-close-btn" onclick="closeTrackedModal()">&times;</button>
    </div>

    <!-- 2-Column Body: Left Video, Right Details Timeline -->
    <div class="tracked-modal-body">
      <!-- Left Column: Unified Video Player & Controls -->
      <div class="tracked-video-col">
        <div class="tracked-video-wrapper">
          <video id="tracked-video-player" controls autoplay playsinline class="modal-video"></video>
        </div>

        <div class="tracked-video-controls">
          <div class="playback-controls">
            <label>Speed:</label>
            <button class="speed-btn active" onclick="setTrackedSpeed(1)">1.0x</button>
            <button class="speed-btn" onclick="setTrackedSpeed(1.5)">1.5x</button>
            <button class="speed-btn" onclick="setTrackedSpeed(2)">2.0x</button>
          </div>

          <a id="tracked-download-btn" href="#" download class="btn btn-secondary btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download Clip (MP4)
          </a>
        </div>
      </div>

      <!-- Right Column: Frigate Tabs (Thumbnail / Tracking Details) & Timeline -->
      <div class="tracked-details-col">
        <!-- Top Tab Pills -->
        <div class="tracked-tabs-nav">
          <button type="button" class="tracked-nav-pill" id="tab-pill-thumb" onclick="switchTrackedTab('thumbnail')">Thumbnail</button>
          <button type="button" class="tracked-nav-pill active" id="tab-pill-details" onclick="switchTrackedTab('details')">Tracking Details</button>
        </div>

        <!-- Tracking Details Pane -->
        <div id="tracked-pane-details" class="tracked-pane">
          <!-- Event Header: Icon, Label, US Date Time Range -->
          <div class="event-meta-header">
            <div class="event-meta-title">
              <span id="dtl-obj-icon" class="event-icon">🚶</span>
              <span id="dtl-obj-label" class="event-label-text">Person</span>
            </div>
            <div id="dtl-obj-timerange" class="event-timerange-text">
              Oct 24, 10:01:10 PM - Oct 24, 10:04:45 PM
            </div>
          </div>

          <!-- Vertical Tracking Timeline -->
          <div class="tracking-timeline-wrapper">
            <div class="timeline-line"></div>
            <div id="timeline-items" class="timeline-items">
              <!-- Dynamically populated timeline dots -->
            </div>
          </div>
        </div>

        <!-- Thumbnail Pane -->
        <div id="tracked-pane-thumbnail" class="tracked-pane" style="display: none;">
          <div class="tracked-thumbnail-wrapper">
            <img id="dtl-thumb-img" src="" alt="Tracked Object Snapshot" class="tracked-thumb-img">
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ========================================================== -->
<!-- 24/7 ARCHIVE PLAYBACK MODAL (Continuous Session Fallback)   -->
<!-- ========================================================== -->
<div id="video-modal" class="modal" style="display: none;">
  <div class="modal-overlay" onclick="closeVideoModal()"></div>
  <div class="modal-dialog">
    <div class="modal-header">
      <div class="modal-title-group">
        <div style="display:flex;align-items:center;gap:8px;">
          <h3 id="modal-video-title">Playback Recording</h3>
          <span id="modal-segment-counter" class="badge badge-info" style="display:none;">Segmen 1 dari 1</span>
        </div>
        <p id="modal-video-subtitle">--</p>
      </div>
      <button class="modal-close-btn" onclick="closeVideoModal()">&times;</button>
    </div>

    <div class="modal-body">
      <div class="modal-video-wrapper">
        <video id="modal-video-player" controls autoplay playsinline class="modal-video"></video>
      </div>
    </div>

    <div class="modal-footer">
      <div class="playback-controls">
        <label>Speed:</label>
        <button class="speed-btn active" onclick="setSpeed(1)">1.0x</button>
        <button class="speed-btn" onclick="setSpeed(1.5)">1.5x</button>
        <button class="speed-btn" onclick="setSpeed(2)">2.0x</button>
        <button class="speed-btn" onclick="setSpeed(4)">4.0x</button>
      </div>

      <div class="session-nav-controls" id="modal-session-nav" style="display: none;">
        <button type="button" class="btn btn-secondary btn-sm" id="btn-prev-segment" onclick="playPrevSegment()" title="Segmen Sebelumnya">
          ⏮ Sebelumnya
        </button>
        <button type="button" class="btn btn-secondary btn-sm" id="btn-next-segment" onclick="playNextSegment()" title="Segmen Selanjutnya">
          Selanjutnya ⏭
        </button>
        <label class="auto-next-label" title="Putar segmen berikutnya otomatis tanpa jeda">
          <input type="checkbox" id="chk-auto-next" checked>
          <span>Lanjut Otomatis (Tanpa Putus)</span>
        </label>
      </div>

      <a id="modal-download-btn" href="#" download class="btn btn-secondary btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download MP4
      </a>
    </div>
  </div>
</div>

<script src="/js/recordings.js"></script>
